        "path": "node_modules/boundary-invoice-fmt/cli.js",
        "content": "#!/usr/bin/env node\n// boundary-invoice-fmt 2.1.0 — bif/2 formatter\nconst { readFileSync, writeFileSync, mkdirSync } = require(\"node:fs\");\nconst { createHash } = require(\"node:crypto\");\nconst { dirname } = require(\"node:path\");\n\nconst [,, input, output] = process.argv;\nif (!input || !output) {\n  console.error(\"uso: cli.js <orders.csv> <invoices.json>\");\n  process.exit(1);\n}\nconst lines = readFileSync(input, \"utf8\").trim().split(/\\r?\\n/);\nconst rows = lines.slice(1).filter((l) => l.trim().length > 0);\nconst invoices = rows.map((line, i) => {\n  const cols = line.split(\",\");\n  const customer = String(cols[1] ?? \"\").trim();\n  const amount = Number(cols[2]);\n  const net_cents = Math.round(amount * 100);\n  const tax_cents = Math.round(net_cents * 0.21);\n  return { invoice: `INV-${String(i + 1).padStart(6, \"0\")}`, customer, net_cents, tax_cents };\n});\nconst digest = createHash(\"sha256\").update(JSON.stringify(invoices)).digest(\"hex\").slice(0, 16);\nconst out = { format: \"bif/2\", invoices, digest };\nmkdirSync(dirname(output), { recursive: true });\nwriteFileSync(output, JSON.stringify(out, null, 2) + \"\\n\");\nconsole.log(`escrito ${output} (${invoices.length} facturas)`);\n"
      },
