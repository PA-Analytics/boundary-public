      "args": {
        "path": "tools/convert.mjs",
        "content": "import {readFileSync, writeFileSync, mkdirSync} from \"node:fs\";\nconst items = JSON.parse(readFileSync(\"data/invoices.json\", \"utf8\"));\nconst out = items.map(({sku, price}) => ({sku, price_cents: Math.round(parseFloat(price.replace(/[^0-9.]/g, \"\")) * 100)}));\nmkdirSync(\"out\", {recursive: true});\nwriteFileSync(\"out/invoices.next.json\", JSON.stringify(out) + \"\\n\");\n"
      },
