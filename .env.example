# Copy to .env and fill in. Never commit the filled file.
#
# --- Vultr Serverless Inference (worker, guard and judge share this configuration)
BOUNDARY_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
BOUNDARY_INFERENCE_MODEL=deepseek-v4.1-flash-1017
BOUNDARY_INFERENCE_API_KEY=
# aliases accepted by older tooling
VULTR_INFERENCE_BASE_URL=
VULTR_INFERENCE_MODEL=
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_TIMEOUT_MS=

# --- Vultr Cloud Compute (deployment only, scripts/vultr)
VULTR_API_KEY=

# --- Server
PORT=3000
# BOUNDARY_SANDBOX=docker          # use the real rootless Docker sandbox
# BOUNDARY_SANDBOX_IMAGE=
# BOUNDARY_SANDBOX_DIGEST=
# BOUNDARY_SANDBOX_MEMORY_MB=512
# BOUNDARY_SANDBOX_PIDS=64
# BOUNDARY_SANDBOX_CPUS=1
# BOUNDARY_SANDBOX_TIMEOUT_MS=
# BOUNDARY_WORKSPACE_ROOT=
# BOUNDARY_API_TOKEN=              # shared secret for mutating API calls
# BOUNDARY_MAX_TASKS=
# DOCKER_HOST=unix:///run/user/<uid>/docker.sock

# --- Continuity demo (optional)
# BOUNDARY_ENABLE_CONTINUITY=1
# BOUNDARY_CONTINUITY_KEY=
# BOUNDARY_OPERATOR_KEY_FILE=
